# -------------------------------------------------------------------
# CONFIGURANDO CONEXÃO COM A API
# -------------------------------------------------------------------
# Define o endereço onde o Front-End vai buscar os dados do chatbot.
#
# MODO DESENVOLVIMENTO (Rodando na sua máquina):
# Mantenha como: http://localhost:3000
#
# MODO PRODUÇÃO (Implantado no Servidor da Empresa):
# Substitua 'localhost' pelo IP Fixo ou Nome do Servidor onde a API (Node.js) está rodando.
# Exemplo: http://192.168.0.50:3000
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:3000